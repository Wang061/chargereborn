menu "AI detector"
    choice AI_DETECTOR
        prompt "detector model"
        default AI_DETECTOR_ESPDET
        help
            Which on-board detector components/ai instantiates.
            espdet: M5 自训 ESPDet-Pico 单类 18650(默认, 板上已验证 219ms)。
            battery_detect4: ESPDet-Pico nc=4 重训(21700/18650/9V/AA), 同架构同
            后处理器, 待上板 A/B 通过后由用户拍板是否设为默认。
            battery_yolo: 队友 YOLOv8n 4 类(21700/18650/9V/AA)。板上实测 5.8s/帧,
            每周期触发 5s task_wdt —— 架构级超载, 已否决, 仅留档勿选(见 CRASH_SIGNATURES 2026-07-04)。

        config AI_DETECTOR_BATTERY_YOLO
            bool "battery_yolo (YOLOv8n 4-class)"

        config AI_DETECTOR_ESPDET
            bool "espdet (ESPDet-Pico single-class 18650)"

        config AI_DETECTOR_BATTERY_DETECT4
            bool "battery_detect4 (ESPDet-Pico 4-class)"
            depends on FLASH_ESPDET_PICO_224_224_BATTERY4
    endchoice
endmenu
