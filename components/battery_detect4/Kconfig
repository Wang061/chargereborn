menu "models: battery_detect4"
    config FLASH_ESPDET_PICO_224_224_BATTERY4
        bool "flash espdet_pico_224_224_battery4"
        depends on !ESPDET4_DETECT_MODEL_IN_SDCARD
        # default n until the trained+quantized .espdl actually lands in models/s3/ -
        # ESP-IDF auto-discovers this component and this flag isn't gated by
        # components/ai's AI_DETECTOR choice (see battery_detect/battery_yolo: both
        # always embed regardless of which one is "selected", hence the 8MB
        # partition). Defaulting y here before the model file exists would break
        # the very next build (pack_espdl_models.py DEPENDS on a missing file).
        # Flip to y once models/s3/espdet_pico_224_224_battery4.espdl is in place.
        default n

    choice
        prompt "default"
        default ESPDET_PICO_224_224_BATTERY4
        help
            default battery_detect4 model
        config ESPDET_PICO_224_224_BATTERY4
            bool "espdet_pico_224_224_battery4"
            depends on ESPDET4_DETECT_MODEL_IN_SDCARD || FLASH_ESPDET_PICO_224_224_BATTERY4
    endchoice

    config DEFAULT_ESPDET4_DETECT_MODEL
        int
        # unconditional 0 (sole enum member): with the scaffold-state FLASH flag
        # off, ESPDET_PICO_224_224_BATTERY4 is unselectable and a "default 0 if"
        # would leave this int valueless -> CONFIG_ macro not emitted -> .hpp
        # default-arg compile error.
        default 0

    choice
        prompt "model location"
        default ESPDET4_DETECT_MODEL_IN_FLASH_RODATA
        help
            espdet4_detect model location
        config ESPDET4_DETECT_MODEL_IN_FLASH_RODATA
            bool "flash_rodata"
        config ESPDET4_DETECT_MODEL_IN_FLASH_PARTITION
            bool "flash_partition"
        config ESPDET4_DETECT_MODEL_IN_SDCARD
            bool "sdcard"
    endchoice

    config ESPDET4_DETECT_MODEL_LOCATION
        int
        default 0 if ESPDET4_DETECT_MODEL_IN_FLASH_RODATA
        default 1 if ESPDET4_DETECT_MODEL_IN_FLASH_PARTITION
        default 2 if ESPDET4_DETECT_MODEL_IN_SDCARD

    config ESPDET4_DETECT_MODEL_SDCARD_DIR
        string "espdet4_detect model sdcard dir"
        default "models/s3" if IDF_TARGET_ESP32S3
        default "models/p4" if IDF_TARGET_ESP32P4
        depends on ESPDET4_DETECT_MODEL_IN_SDCARD
        help
            Directory of models relative to sdcard mount point.
endmenu
